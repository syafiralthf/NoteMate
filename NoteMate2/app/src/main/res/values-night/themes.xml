<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme untuk Mode Malam -->
    <!-- Kita samakan menggunakan MaterialComponents agar tidak crash -->
    <style name="Base.Theme.NoteMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Warna Utama (Tetap Kuning agar identitas NoteMate kuat) -->
        <item name="colorPrimary">#FFD700</item>
        <item name="colorPrimaryVariant">#FFC107</item>
        <item name="colorOnPrimary">@android:color/black</item>

        <!-- Warna Latar Belakang Gelap -->
        <item name="android:windowBackground">#121212</item>
        <item name="android:colorBackground">#121212</item>

        <!-- Warna Secondary -->
        <item name="colorSecondary">#03DAC6</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <!-- Status Bar untuk Mode Malam -->
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>